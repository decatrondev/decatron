<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de la plataforma multi-tenant (.dev/plans/plataforma/FASE3_DISENO.md §3.6).
    Corren contra una base DESECHABLE (decatron_test), nunca contra decatron_prod ni decatron_staging.
    Conexión: variable de entorno DECATRON_TEST_CONN; sin ella las pruebas de base de datos se omiten.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Compile Include="../Decatron.Controllers/AuthController.cs" Link="Controllers/AuthController.cs" />
    <Compile Include="../Decatron.Controllers/KickAuthController.cs" Link="Controllers/KickAuthController.cs" />
    <Compile Include="../Decatron.Discord/DiscordAuthController.cs" Link="Controllers/DiscordAuthController.cs" />
    <ProjectReference Include="../Decatron.Core/Decatron.Core.csproj" />
    <ProjectReference Include="../Decatron.Data/Decatron.Data.csproj" />
    <ProjectReference Include="../Decatron.Business/Decatron.Business.csproj" />
  </ItemGroup>

</Project>
